# ============================================================
# Nepali Word Game — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# ----- Node Environment -----
NODE_ENV=development
PORT=3000

# ----- Database -----
DB_HOST=mysql
DB_PORT=3306
DB_ROOT_PASSWORD=changeme_root
DB_NAME=nepali_word_game
DB_USER=nwg_user
DB_PASSWORD=changeme_nwg

# ----- JWT -----
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=your_very_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ----- CORS -----
# In production, set this to your actual domain:
# CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*

# ----- Email (Option 1: Resend API - Recommended for Railway/Cloud) -----
# RESEND_API_KEY=re_123456789
# RESEND_FROM_EMAIL=onboarding@resend.dev

# ----- Email (Option 2: Gmail SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password

# ----- Email (Option 3: Gmail REST API via OAuth2 - Fallback for blocked SMTP) -----
# Bypasses Railway / Cloud host SMTP (port 587) blocking via HTTPS port 443
# Links to generate credentials:
# 1. Google Cloud Console (Client ID & Secret): https://console.cloud.google.com/apis/credentials
# 2. Enable Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 3. OAuth Playground (Refresh Token): https://developers.google.com/oauthplayground
# GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your_client_secret
# GMAIL_REFRESH_TOKEN=your_refresh_token
# GMAIL_USER=your.email@gmail.com

# ----- Frontend URL -----
# Used for email verification links
# In production, set this to your actual domain:
FRONTEND_URL=http://localhost:8888

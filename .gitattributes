# Auto-detect text files and perform LF normalization on checkout
* text=auto

# Force LF line endings for shell scripts, SQL scripts, Makefile, and Docker files
# (Critical for Windows checkouts to avoid execution failures inside Linux containers)
*.sh text eol=lf
*.bash text eol=lf
*.sql text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf
.env* text eol=lf
